  /api/v1/conversation/:
    get:
      operationId: api_v1_conversation_list
      description: |-
        List all conversations for current user.

        GET /api/conversations/

        Returns: Paginated list of conversations with message counts and unread status
      parameters:
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - name: page_size
        required: false
        in: query
        description: Number of conversations per page
        schema:
          type: integer
      - in: query
        name: participant_one__profile__display_name__icontains
        schema:
          type: string
      - in: query
        name: participant_two__profile__display_name__icontains
        schema:
          type: string
      tags:
      - api
      security:
      - jwtAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedConversationList'
          description: ''
    post:
      operationId: api_v1_conversation_create
      description: |-
        Create a new conversation.

        POST /api/conversations/

        Body:
        {
            "participant_two_id": 2
        }

        Returns: Conversation object with participants
      tags:
      - api
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/ConversationCreate'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/ConversationCreate'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/ConversationCreate'
        required: true
      security:
      - jwtAuth: []
      responses:
        '201':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ConversationCreate'
          description: ''
