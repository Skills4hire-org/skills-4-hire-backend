  /api/v1/address/:
    get:
      operationId: api_v1_address_list
      parameters:
      - in: query
        name: apartment
        schema:
          type: string
      - in: query
        name: city
        schema:
          type: string
      - in: query
        name: country
        schema:
          type: string
