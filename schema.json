        * `WITHDRAW` - Withdraw
    UserCreateUpdate:
      type: object
      properties:
        first_name:
          type: string
          maxLength: 200
        last_name:
          type: string
          maxLength: 200
        phone:
          type: string
          nullable: true
          maxLength: 50
      required:
      - first_name
      - last_name
    UserRead:
      type: object
      properties:
        user_id:
          type: string
          format: uuid
        phone:
          type: string
          nullable: true
          maxLength: 50
        email:
          type: string
          format: email
          nullable: true
          maxLength: 100
        first_name:
          type: string
          maxLength: 200
        last_name:
          type: string
          maxLength: 200
        is_provider:
          type: boolean
        is_customer:
          type: boolean
        is_verified:
          type: boolean
        profile:
          allOf:
          - $ref: '#/components/schemas/BaseProfileList'
          readOnly: true
      required:
      - first_name
      - last_name
      - profile
    WalletDetail:
      type: object
      properties:
        wallet_id:
          type: string
          format: uuid
        user_email:
          type: string
        is_active:
          type: boolean
        created_at:
          type: string
          format: date-time
          readOnly: true
        available_balance:
          type: string
          format: decimal
          pattern: ^-?\d{0,6}(?:\.\d{0,2})?$
          readOnly: true
        overall_balance:
          type: string
          readOnly: true
        overall_locked_balance:
          type: string
          readOnly: true
        transactions:
          type: string
          readOnly: true
      required:
      - available_balance
      - created_at
      - overall_balance
      - overall_locked_balance
      - transactions
      - user_email
    WalletTransactionSummary:
      type: object
      properties:
        transaction_id:
          type: string
          format: uuid
          readOnly: true
        amount:
          type: string
          format: decimal
          pattern: ^-?\d{0,6}(?:\.\d{0,2})?$
        type:
          $ref: '#/components/schemas/TypeEnum'
        status:
          $ref: '#/components/schemas/WalletTransactionSummaryStatusEnum'
        reference_key:
          type: string
          maxLength: 50
      required:
      - amount
      - transaction_id
    WalletTransactionSummaryStatusEnum:
      enum:
      - PENDING
      - PROCESSING
      - COMPLETED
      - FAILED
      type: string
      description: |-
        * `PENDING` - Pending
        * `PROCESSING` - Processing
        * `COMPLETED` - Completed
        * `FAILED` - Failed
    WithDrawal:
      type: object
      properties:
        amount:
          type: string
          format: decimal
          pattern: ^-?\d{0,6}(?:\.\d{0,2})?$
        idempotency_key:
          type: string
          format: uuid
        recipient_code:
          type: string
          writeOnly: true
          maxLength: 50
      required:
      - amount
      - idempotency_key
      - recipient_code
    WorkImages:
      type: object
      properties:
        work_image_id:
          type: string
          format: uuid
          readOnly: true
        image_url:
          type: string
          format: uri
          maxLength: 200
        description:
          type: string
          nullable: true
          maxLength: 255
        public_id:
          type: string
          maxLength: 255
        created_at:
          type: string
          format: date-time
          readOnly: true
        type:
          type: string
          nullable: true
          maxLength: 50
        thumbnail_url:
          type: string
          format: uri
          readOnly: true
          nullable: true
      required:
      - created_at
      - thumbnail_url
      - work_image_id
  securitySchemes:
    jwtAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
