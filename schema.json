    FeedPost:
      type: object
      description: |-
        Serializer for posts in the personalized feed/recommendation endpoint.

        Includes:
        - All core post fields (title, content, type, timestamps)
        - Creator profile with trust_score and location
        - Engagement metrics (likes, comments, reposts)
        - Repost information (is_reposted, repost_comment if applicable)
        - Recommendation score (passed via context from the view)

        The recommendation_score is injected by the view based on the ranking
        algorithm's multi-signal scoring.
      properties:
        post_id:
          type: string
          format: uuid
        post_title:
          type: string
          nullable: true
          maxLength: 500
        user:
          allOf:
          - $ref: '#/components/schemas/UserRead'
          readOnly: true
        post_content:
          type: string
        post_type:
          nullable: true
          oneOf:
          - $ref: '#/components/schemas/PostTypeEnum'
          - $ref: '#/components/schemas/NullEnum'
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
        tags:
          type: array
          items:
            $ref: '#/components/schemas/ServiceCategory'
          readOnly: true
        attachments:
          type: array
          items:
            $ref: '#/components/schemas/PostAttachment'
          readOnly: true
        comments_count:
          type: integer
          readOnly: true
        likes_count:
          type: integer
          readOnly: true
        reposts_count:
          type: integer
          readOnly: true
        is_liked:
          type: string
          readOnly: true
        is_commented:
          type: string
          readOnly: true
        is_reposted:
          type: string
          readOnly: true
        duration:
          type: string
          readOnly: true
        post_status:
          type: string
          readOnly: true
        amount:
          type: string
          format: decimal
          pattern: ^-?\d{0,8}(?:\.\d{0,2})?$
          nullable: true
        start_date:
          type: string
          format: date-time
          nullable: true
        end_date:
          type: string
          format: date-time
          nullable: true
        is_remote:
          type: boolean
        country:
          type: string
          nullable: true
          maxLength: 100
        city:
          type: string
          nullable: true
          maxLength: 100
        state:
          type: string
          nullable: true
          maxLength: 100
        recommendation_score:
          type: number
          format: double
          description: |-
            Retrieve the recommendation score from context.

            The view is responsible for computing the score using
            RecommendationService and passing it via context.

            Args:
                obj: Post instance

            Returns:
                Float between 0.0 and ~1.5 (may exceed 1.0 due to active user boost)
          readOnly: true
      required:
      - attachments
      - comments_count
      - created_at
      - duration
      - is_commented
      - is_liked
      - is_reposted
      - likes_count
      - post_content
      - post_status
      - recommendation_score
      - reposts_count
      - tags
      - updated_at
      - user
